# Dedicated SSH daemon for remote Claude access.  Do not add general shell access.
Port 2223
ListenAddress 127.0.0.1
Protocol 2
HostKey /etc/claude-remote/ssh_host_ed25519_key
PidFile /run/claude-remote-sshd.pid
AuthorizedKeysFile /etc/claude-remote/authorized_keys/%u
PermitRootLogin no
PasswordAuthentication no
KbdInteractiveAuthentication no
AuthenticationMethods publickey
PubkeyAuthentication yes
UsePAM yes
PermitEmptyPasswords no
PermitUserEnvironment no
AllowUsers claude-sync claude-mcp claude-playwright claude-shell
LogLevel VERBOSE
Subsystem sftp internal-sftp

Match User claude-sync
    ChrootDirectory /srv/claude-remote
    ForceCommand internal-sftp -d /
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no

Match User claude-mcp
    ForceCommand /usr/local/libexec/claude-mcp-launch
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no

Match User claude-playwright
    ForceCommand /usr/local/libexec/claude-playwright-launch
    PermitTTY no
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no

Match User claude-shell
    ForceCommand /usr/local/libexec/claude-shell-launch
    PermitTTY yes
    AllowTcpForwarding no
    AllowAgentForwarding no
    X11Forwarding no
    PermitTunnel no
